{
  "name": "apex-factory-hackathon",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "lefthook install",
    "check": "node scripts/check-content-invariants.mjs && npm test && npm run lint:md && npm run format:check",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write \"site/**/*.{astro,js,mjs,ts}\"",
    "format:check": "prettier --check \"site/**/*.{astro,js,mjs,ts}\"",
    "lint:md": "markdownlint-cli2"
  },
  "devDependencies": {
    "lefthook": "^2.1.17",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0"
  },
  "overrides": {
    "micromark-extension-math": { "katex": "^0.18.0" },
    "markdown-it": "^15.0.3",
    "smol-toml": "^1.8.0"
  }
}
