---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { getCollection } from "astro:content";
import "../../components/coach.css";

const entries = await getCollection("coach");
const challenges = entries
  .filter((entry) => entry.data.kind === "challenge")
  .sort((a, b) => a.id.localeCompare(b.id));
const others = [
  { id: "run-of-show", title: "Two-day agenda" },
  { id: "readiness", title: "Readiness check" },
  { id: "lifelines", title: "Lifelines" },
  { id: "curveballs", title: "Curveballs" },
  { id: "apex-demo", title: "APEX demo script" },
  { id: "automation-map", title: "Automation map" },
  { id: "deploy-with-scripts", title: "Repair: deploy with scripts" },
];

const frontmatter = {
  title: "Coach cheat sheets",
  description: "Coach material: answers, lifelines and the run of show.",
  editUrl: false,
  lastUpdated: false,
  prev: false,
  next: false,
  tableOfContents: false,
} as const;
---

<StarlightPage frontmatter={frontmatter}>
  <div class="coach-sheet">
    <aside class="coach-banner" role="note">
      <strong>Coach material: it contains the answers.</strong> If you're attending as a member,
      please don't read ahead. We run on trust.
    </aside>

    <p>
      One cheat sheet per challenge, rendered from the <code>coach/</code> folder, plus the
      Readiness check and the coach-only repair path. Start with Two-day agenda in the sidebar, then
      Readiness check and C1 to C10. Lifelines, Curveballs and APEX demo script are also in the
      sidebar.
    </p>

    <h2>Challenges</h2>
    <table>
      <thead>
        <tr>
          <th>Challenge</th>
          <th>Scope</th>
          <th>Minutes</th>
        </tr>
      </thead>
      <tbody>
        {challenges.map(({ id, data }) => (
          <tr>
            <td>
              <a href={`/coach/${id}/`}>{data.title}</a>
            </td>
            <td>{data.scope}</td>
            <td>{data.minutes}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Run the event</h2>
    <ul>
      {others.map(({ id, title }) => (
        <li>
          <a href={`/coach/${id}/`}>{title}</a>
        </li>
      ))}
    </ul>
  </div>
</StarlightPage>
