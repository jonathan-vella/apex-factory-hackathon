---
// Pre-work timeline: what is due when, and roughly how long each part takes.
type Phase = {
  title: string;
  detail?: string;
  time: string;
  mins: number;
  unattended?: boolean;
  href?: string;
};
type Stop = { when: string; label: string; note: string; phases: Phase[] };

const stops: Stop[] = [
  {
    when: "T-14",
    label: "14 days before day one",
    note: "Due by now: your accounts, tools and repo are ready and preflight is green.",
    phases: [
      {
        title: "Requirements and repo setup",
        detail:
          "Accounts, tools, your repo, the dev container, the kit import, settings and the manual checks.",
        time: "60 to 90 min",
        mins: 90,
        href: "/deploy/set-up-your-repo/",
      },
      {
        title: "Preflight",
        detail: "Fix every red check; confirm the five manual rows.",
        time: "15 min, plus up to 15 waiting",
        mins: 30,
        href: "/deploy/member-steps/#t-14-preflight",
      },
    ],
  },
  {
    when: "T-3",
    label: "3 days before day one",
    note: "Due by now: the readiness check passes. The datacenter is deployed, tested and connected to Azure Arc, and vm-dev01 is ready.",
    phases: [
      {
        title: "Deploy your datacenter",
        time: "30 to 60 min, unattended",
        mins: 60,
        unattended: true,
        href: "/deploy/member-steps/#t-3-deploy-your-datacenter",
      },
      {
        title: "Test the datacenter, before Arc",
        time: "about 5 min",
        mins: 5,
        href: "/deploy/member-steps/#t-3-deploy-your-datacenter",
      },
      {
        title: "Onboard vm-app01 to Azure Arc",
        time: "10 to 20 min, unattended",
        mins: 20,
        unattended: true,
        href: "/deploy/member-steps/#t-3-deploy-your-datacenter",
      },
      {
        title: "First Arc SQL migration assessment",
        time: "about 15 min",
        mins: 15,
        href: "/deploy/member-steps/#readiness-check",
      },
      {
        title: "Check Hybrid Benefit and cost",
        time: "about 5 min",
        mins: 5,
        href: "/deploy/member-steps/#readiness-check",
      },
      {
        title: "Set up vm-dev01",
        time: "about 30 min",
        mins: 30,
        href: "/deploy/member-steps/#set-up-vm-dev01",
      },
    ],
  },
  {
    when: "Day 1",
    label: "The event starts",
    note: "Your team lead vends your subscription at T-1. C1 opens on a ready datacenter and foundation. About 4 to 4.5 hours of pre-work in total, spread over 11 days.",
    phases: [],
  },
];
---

<div class="ptl not-content">
  <ol class="ptl__stops">
    {stops.map((stop) => (
      <li class="ptl__stop">
        <div class="ptl__marker">
          <span class="ptl__when">{stop.when}</span>
        </div>
        <div class="ptl__body">
          <div class="ptl__head">
            <strong>{stop.label}</strong>
            <span>{stop.note}</span>
          </div>
          {stop.phases.length > 0 && (
            <ul class="ptl__phases">
              {stop.phases.map((p) => (
                <li class="ptl__phase">
                  <div class="ptl__row">
                    <span class="ptl__title">
                      {p.href ? <a href={p.href}>{p.title}</a> : p.title}
                    </span>
                    <span class="ptl__time">{p.time}</span>
                  </div>
                  <div class="ptl__bar" aria-hidden="true">
                    <span
                      class:list={["ptl__fill", { "ptl__fill--wait": p.unattended }]}
                      style={`width:${Math.max(4, Math.round((p.mins / 90) * 100))}%`}
                    />
                  </div>
                  {p.detail && <p class="ptl__detail">{p.detail}</p>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>
  <p class="ptl__legend">
    <span class="ptl__key ptl__key--work">Your time</span>
    <span class="ptl__key ptl__key--wait">Unattended: start it and do something else</span>
    Bar length is relative to the longest part (90 minutes).
  </p>
</div>

<style>
  .ptl {
    --ptl-work: var(--sl-color-accent, #0078d4);
    --ptl-wait: #ffb44c;
    margin: 1.5rem 0;
  }

  :global(:root[data-theme="light"]) .ptl {
    --ptl-wait: #b35f00;
  }

  .ptl__stops {
    position: relative;
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ptl__stops::before {
    content: "";
    position: absolute;
    left: 2.1rem;
    top: 1rem;
    bottom: 1rem;
    width: 3px;
    background: linear-gradient(180deg, var(--ptl-work), var(--ptl-wait));
    opacity: 0.55;
  }

  .ptl__stop {
    position: relative;
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: 0.9rem;
    margin: 0;
  }

  .ptl__marker {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .ptl__when {
    display: inline-block;
    min-width: 3.9rem;
    padding: 0.3rem 0.5rem;
    border: 2px solid var(--ptl-work);
    border-radius: 999px;
    background: var(--sl-color-bg, #0d1117);
    color: var(--sl-color-white, #fff);
    font-family: var(--font-display, inherit);
    font-size: 0.85rem;
    font-weight: 800;
    text-align: center;
  }

  .ptl__head {
    display: grid;
    gap: 0.1rem;
    padding-top: 0.2rem;
  }

  .ptl__head strong {
    color: var(--sl-color-white, #fff);
    font-size: 1rem;
  }

  .ptl__head span {
    color: var(--sl-color-gray-2, #8b949e);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .ptl__phases {
    display: grid;
    gap: 0.6rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ptl__phase {
    margin: 0;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5, #30363d);
    border-radius: 0.7rem;
    background: var(--sl-color-gray-6, #21262d);
  }

  :global(:root[data-theme="light"]) .ptl__phase {
    background: var(--sl-color-gray-7, #f6f8fa);
  }

  .ptl__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.1rem 0.75rem;
  }

  .ptl__title {
    color: var(--sl-color-white, #fff);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .ptl__time {
    color: var(--sl-color-gray-2, #8b949e);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .ptl__bar {
    height: 0.45rem;
    margin-top: 0.45rem;
    border-radius: 999px;
    background: var(--sl-color-gray-5, #30363d);
    overflow: hidden;
  }

  .ptl__fill {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--ptl-work);
  }

  .ptl__fill--wait {
    background: var(--ptl-wait);
  }

  .ptl__detail {
    margin: 0.4rem 0 0;
    color: var(--sl-color-gray-2, #8b949e);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .ptl__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.1rem;
    margin: 1rem 0 0;
    color: var(--sl-color-gray-2, #8b949e);
    font-size: 0.8rem;
  }

  .ptl__key::before {
    content: "";
    display: inline-block;
    width: 1.1rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 999px;
    vertical-align: 0.05rem;
  }

  .ptl__key--work::before {
    background: var(--ptl-work);
  }

  .ptl__key--wait::before {
    background: var(--ptl-wait);
  }
</style>
