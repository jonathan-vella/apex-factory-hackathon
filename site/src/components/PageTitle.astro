---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { challenges } from "../data/challenges.json";
import ProgressTracker from "./ProgressTracker.astro";

const slug = Astro.locals.starlightRoute.entry.id;
const challenge = challenges.find(
  ({ file }) => `challenges/${file.replace(/\.mdx?$/, "")}` === slug,
);
---

{Astro.url.pathname !== "/" && (
  <Default {...Astro.props}>
    <slot />
  </Default>
)}
{challenge && (
  <div class="challenge-brief" data-scope={challenge.scope}>
    <ul class="challenge-brief__facts" aria-label="Challenge at a glance">
      <li>{challenge.day}</li>
      <li>{challenge.scope === "Team" ? "Team challenge" : "Member challenge"}</li>
      <li>{challenge.minutes} min</li>
    </ul>
    <nav class="challenge-brief__links" aria-label="Challenge shortcuts">
      <a href="#requirements">
        Requirements <span aria-hidden="true">↓</span>
      </a>
      <a href="#success-criteria">
        Success criteria <span aria-hidden="true">↓</span>
      </a>
    </nav>
  </div>
)}
<ProgressTracker />
