---
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { getCollection } from "astro:content";
import ProgressTracker from "./ProgressTracker.astro";

const match = Astro.locals.starlightRoute.entry.id.match(/^challenges\/c(\d+)-/);
let position;
if (match && Number(match[1]) >= 1) {
  const docs = await getCollection("docs");
  const total = docs.filter((d) => {
    const m = d.id.match(/^challenges\/c(\d+)-/);
    return m && Number(m[1]) >= 1;
  }).length;
  const index = Number(match[1]);
  position = { label: `C${index}`, current: index, total };
}
---

{position && (
  <p class="challenge-position">
    <span class="challenge-position__label">
      {position.label} · challenge {position.current} of {position.total}
    </span>
    <span class="challenge-position__bar" aria-hidden="true">
      {Array.from({ length: position.total }, (_, i) => (
        <span class:list={{ "is-done": i < position.current }} />
      ))}
    </span>
  </p>
)}
{Astro.url.pathname !== "/" && (
  <Default {...Astro.props}>
    <slot />
  </Default>
)}
<ProgressTracker />
