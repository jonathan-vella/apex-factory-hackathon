---
// Buttons and spacing for the landing page only.
---

<style is:global>
  .landing-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    align-items: center;
    margin-top: 1.5rem;
  }

  .landing-button {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--lp-accent-text);
    border-radius: 999px;
    color: var(--lp-accent-text);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
  }

  .landing-button--primary {
    background: var(--sl-color-accent);
    border-color: var(--sl-color-accent);
    color: #fff;
  }

  :root[data-theme="light"] .landing-button--primary {
    background: #005a9e;
    border-color: #005a9e;
  }

  .landing-button:hover {
    border-color: var(--lp-heading);
    color: var(--lp-heading);
  }

  .landing-button--primary:hover {
    color: #fff;
    filter: brightness(1.12);
  }

  .scenario-frame__columns {
    align-items: start;
  }
</style>
