---
import { Aside, Code, Steps } from "@astrojs/starlight/components";

interface Props {
  pathMode: "self-service" | "lead-provisioned";
}

const { pathMode } = Astro.props;
const isPathB = pathMode === "lead-provisioned";

const step1PathA = `./scripts/Get-PipelineEvidence.ps1
$s = Get-Content .local/settings.json | ConvertFrom-Json
(Get-Content ".local/$($s.subscriptionId)/datacenter.json" | ConvertFrom-Json).adminPassword
$s.subscriptionId
git remote get-url origin`;

const step1PathB = `$s = Get-Content .local/settings.json | ConvertFrom-Json
(Get-Content ".local/$($s.subscriptionId)/datacenter.json" | ConvertFrom-Json).adminPassword
git remote get-url origin`;

const step3GitHub = `gh auth login --web
gh auth setup-git
$u = gh api user | ConvertFrom-Json
git config --global user.name ($u.name ?? $u.login)
git config --global user.email "$($u.id)+$($u.login)@users.noreply.github.com"`;

const step4AzurePathA = `az login --use-device-code
az account set --subscription '<workload-subscription-id>'
az account show --query name -o tsv
[Environment]::SetEnvironmentVariable('AZURE_TOKEN_CREDENTIALS', 'AzureCliCredential', 'User')`;

const step4AzurePathB = `az login --tenant '<tenant-id>' --use-device-code
az account set --subscription '<workload-subscription-id>'
az account show --query name -o tsv
[Environment]::SetEnvironmentVariable('AZURE_TOKEN_CREDENTIALS', 'AzureCliCredential', 'User')`;

const step5Refresh = `cd C:\\src\\factory
git switch main
git pull`;

const step5SparseFallback = `git clone --no-checkout https://github.com/jonathan-vella/apex-factory-hackathon.git C:\\src\\factory
cd C:\\src\\factory
git sparse-checkout set --no-cone \`
  '/*' '!/coach/' '!/facilitator/' '!/docs/' '!/site/' '!/test/' \`
  '!/.vale/' '!/.vale.ini' '!/.markdownlint-cli2.mjs' '!/.prettierignore' \`
  '!/prettier.config.mjs' '!/lefthook.yml' '!/package.json' \`
  '!/package-lock.json' '!/.node-version' '!/.nvmrc'
git checkout`;

const step6Remote = isPathB
  ? `cd C:\\src\\factory
git remote add member https://github.com/<org>/<your-repo>.git
git switch -c vm-dev01-work
git push -u member vm-dev01-work
git remote -v
git branch -vv`
  : `cd C:\\src\\factory
git remote add member https://github.com/<your-org>/<your-repo>.git
git switch -c vm-dev01-work
git push -u member vm-dev01-work
git remote -v
git branch -vv`;

const step7Clone = isPathB
  ? `git clone https://github.com/<org>/<your-repo>.git C:\\src\\<your-repo>`
  : `git clone https://github.com/<your-org>/<your-repo>.git C:\\src\\<your-repo>`;

const step8Code = `code C:\\src\\factory`;
---

{isPathB ? (
  <p>
    <strong>Who runs this:</strong> Every student, on their own assigned <code>vm-dev01</code>.
    <br />
    <strong>Why:</strong> From C3 onward, the Contoso University app and SQL Server live behind
    private endpoints inside your datacenter and spoke network—your laptop Dev Container (or
    Codespace) cannot reach them, so all C3, C6, C7, C8 (VM checks) and C9 work runs on{" "}
    <code>vm-dev01</code>.
  </p>
) : (
  <p>
    <strong>Who runs this:</strong> Every team member—including the team lead—for their own{" "}
    <code>vm-dev01</code>.
    <br />
    <strong>Why:</strong> From C3 onward, the Contoso University app and SQL Server live behind
    private endpoints inside your datacenter and spoke network—your laptop Dev Container cannot
    reach them, so all C3, C6, C7, C8 (VM checks) and C9 work runs on <code>vm-dev01</code>.
  </p>
)}

<Aside type="tip" title="One GitHub repo — why vm-dev01 has two local folders">
  {isPathB ? (
    <p>
      <strong>Do not create a new GitHub repository.</strong> Reuse the single private{" "}
      <code>&lt;org&gt;/&lt;your-repo&gt;</code> student repo from your Handoff Card (for example{" "}
      <code>&lt;org&gt;/&lt;event&gt;-student-01</code>). Your student repo&apos;s <code>main</code>{" "}
      branch has the APEX accelerator at the root and the kit nested under <code>factory/</code>,
      whereas GitHub Copilot&apos;s Upgrade agent requires the kit at the workspace root so it can
      discover <code>.github/skills/</code> and <code>.github/modernization/</code>. That is why{" "}
      <code>vm-dev01</code> uses two local folders backed by your <strong>same</strong> GitHub repo:
    </p>
  ) : (
    <p>
      <strong>Do not create a new GitHub repository.</strong> Reuse the single private{" "}
      <code>&lt;your-org&gt;/&lt;your-repo&gt;</code> repo you created in{" "}
      <a href="/deploy/set-up-your-repo/#11-create-your-repo-everyone">Step 1.1</a>. Your Step 1
      repo&apos;s <code>main</code> branch has the APEX accelerator at the root and the kit nested
      under <code>factory/</code>, whereas GitHub Copilot&apos;s Upgrade agent requires the kit at
      the workspace root so it can discover <code>.github/skills/</code> and{" "}
      <code>.github/modernization/</code>. That is why <code>vm-dev01</code> uses two local folders
      backed by your <strong>same</strong> GitHub repo:
    </p>
  )}
  <ul>
    <li>
      <strong>
        <code>C:\src\factory</code> (app &amp; upgrade workspace):
      </strong>{" "}
      pre-cloned on the VM from the public kit at the root. In step 6 you add a <code>member</code>{" "}
      remote pointing to your existing GitHub repo and push your code on a separate{" "}
      <code>vm-dev01-work</code> branch (never merged into <code>main</code>).
    </li>
    <li>
      <strong>
        <code>C:\src\&lt;your-repo&gt;</code> (evidence workspace):
      </strong>{" "}
      a normal clone of your existing GitHub repo on <code>main</code> (step 7), used only to commit
      and push screenshots, reports and C9 scripts under <code>factory\evidence\</code>.
    </li>
  </ul>
</Aside>

<p>
  Keep two browser windows open on your own computer: one for Azure Bastion, the other for the Azure
  portal and this guide (allow portal pop-ups and Bastion clipboard access, and enter device sign-in
  codes on your own computer where your passkeys and password manager work). Each step below labels{" "}
  <strong>where</strong> you run it:
</p>

<Steps>
  <ol>
    <li>
      {isPathB ? (
        <>
          <p>
            <strong>
              [In your Dev Container or Codespace — <code>factory/</code>]
            </strong>{" "}
            Read your <code>vm-dev01</code> password and student repo URL so you have them ready
            before opening Bastion:
          </p>
          <Code code={step1PathB} lang="powershell" />
          <p>
            Copy the <code>labadmin</code> password (which also opens <code>vm-app01</code>) and
            your student repo URL (<code>https://github.com/&lt;org&gt;/&lt;your-repo&gt;.git</code>
            ), along with <code>&lt;tenant-id&gt;</code> and{" "}
            <code>&lt;workload-subscription-id&gt;</code> from your Handoff Card.
          </p>
        </>
      ) : (
        <>
          <p>
            <strong>
              [On your laptop, in your Dev Container — <code>factory/</code>]
            </strong>{" "}
            Download your readiness artifact and print your <code>vm-dev01</code> password, workload
            subscription ID and Step 1 repo URL:
          </p>
          <Code code={step1PathA} lang="powershell" />
          <p>
            <code>Get-PipelineEvidence.ps1</code> saves{" "}
            <code>factory/evidence/readiness/test-datacenter.txt</code> and writes{" "}
            <code>.local/&lt;subscription-id&gt;/datacenter.json</code> (using{" "}
            <code>memberIndex</code> from <code>.local/settings.json</code>, so the exact same
            command works in both member repos and the team lead&apos;s repo). Keep the{" "}
            <code>labadmin</code> password, subscription ID and Step 1 repo URL (
            <code>https://github.com/&lt;your-org&gt;/&lt;your-repo&gt;.git</code>) privately for
            the steps below.
          </p>
          <details>
            <summary>If Arc failed and datacenter.json was not downloaded</summary>
            <p>
              For the standard disposable lab, run{" "}
              <code>./scripts/Initialize-Settings.ps1 -WriteLabCredentials</code> from{" "}
              <code>factory/</code> to write the{" "}
              <a href="https://github.com/jonathan-vella/apex-factory-hackathon/blob/main/infra/datacenter/README.md#credentials">
                standard lab credentials
              </a>{" "}
              locally; for custom credentials, ask your team lead privately. Do not publish the
              password or rerun <code>member</code> just to recreate <code>datacenter.json</code>.
            </p>
          </details>
        </>
      )}
    </li>

    <li>
      <p>
        <strong>[On your laptop browser — Azure portal]</strong> Connect to <code>vm-dev01</code>{" "}
        through Bastion so you have a desktop inside the private datacenter network. Filter the
        portal to your directory and workload subscription, open <strong>Resource groups</strong>{" "}
        &gt; <strong>rg-datacenter</strong> &gt; <strong>vm-dev01</strong> &gt;{" "}
        <strong>Connect</strong> &gt; <strong>Bastion</strong>, select <strong>Password</strong>,
        enter <code>labadmin</code> and the password from step 1, and choose{" "}
        <strong>Connect</strong>. On first sign-in, wait up to five minutes for VS Code extensions
        to finish installing. (Optional Windows shortcut:{" "}
        <code>./scripts/Connect-DatacenterVm.ps1</code> with PowerShell 7 and the Azure CLI{" "}
        <code>bastion</code> extension.)
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>)]
        </strong>{" "}
        Sign in to GitHub and configure your git author identity (never use Windows PowerShell 5.1)
        so Git and Copilot on the VM can authenticate and push to your private repo:
      </p>
      <Code code={step3GitHub} lang="powershell" />
      <p>
        Choose <strong>GitHub.com</strong>, <strong>HTTPS</strong> and <strong>Yes</strong> to
        authenticate Git, then enter the one-time code at{" "}
        <code>https://github.com/login/device</code> in your laptop browser.
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>)]
        </strong>{" "}
        Sign in to Azure as yourself and set <code>AZURE_TOKEN_CREDENTIALS=AzureCliCredential</code>{" "}
        so local app runs use <em>your</em> Entra data roles instead of the VM&apos;s policy-added
        system identity (which has no data permissions):
      </p>
      <Code code={isPathB ? step4AzurePathB : step4AzurePathA} lang="powershell" />
      <p>
        Enter the code at <code>https://microsoft.com/devicelogin</code> on your laptop (or run{" "}
        <code>az login</code> inside Bastion if device code is blocked) and confirm the subscription
        name matches your workload subscription. Open VS Code only <em>after</em> setting{" "}
        <code>AZURE_TOKEN_CREDENTIALS</code>, and never set that variable on App Service.
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>)]
        </strong>{" "}
        Refresh the pre-cloned public kit at <code>C:\src\factory</code> once so you start from the
        latest kit files before creating your work branch:
      </p>
      <Code code={step5Refresh} lang="powershell" />
      <details>
        <summary>Only if C:\src\factory is missing on vm-dev01</summary>
        <p>
          Ask your team lead before the event or your coach on event days first. If they ask you to
          recreate it, run this sparse clone so coach answer keys and site tooling stay out:
        </p>
        <Code code={step5SparseFallback} lang="powershell" wrap />
      </details>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>), in{" "}
          <code>C:\src\factory</code>]
        </strong>{" "}
        Link <code>C:\src\factory</code> to your existing GitHub repo as the <code>member</code>{" "}
        remote and push a new <code>vm-dev01-work</code> branch—this backs up your C3/C6 app
        modernization commits to your own private GitHub repo because you cannot push to the public
        kit (<code>origin</code>):
      </p>
      <Code code={step6Remote} lang="powershell" />
      <p>
        Use the exact repo URL from step 1 (do not create a new GitHub repo). Verify{" "}
        <code>origin</code> is the public kit, <code>member</code> is your private repo, and{" "}
        <code>vm-dev01-work</code> tracks <code>member/vm-dev01-work</code>. Never push to{" "}
        <code>origin</code>, never run <code>git pull</code> in <code>C:\src\factory</code> after
        this step, and never merge <code>vm-dev01-work</code> into <code>main</code> (see{" "}
        <a href="/guides/ghcp-upgrade/#save-your-work-and-keep-the-branches-straight">
          Save your work and keep the branches straight
        </a>
        ).
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>)]
        </strong>{" "}
        Clone that same existing GitHub repo into <code>C:\src\&lt;your-repo&gt;</code> on{" "}
        <code>main</code>—this gives you a clean working copy on the VM where you save screenshots,
        reports and C9 scripts into <code>factory\evidence\</code> without touching your app branch:
      </p>
      <Code code={step7Clone} lang="powershell" />
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>), then VS Code]
        </strong>{" "}
        Open VS Code at the root of <code>C:\src\factory</code> and sign in to GitHub
        Copilot—opening <code>C:\src\factory</code> (not <code>app/</code> and not{" "}
        <code>C:\src\&lt;your-repo&gt;</code>) ensures Copilot discovers{" "}
        <code>.github/skills/</code> and <code>.github/modernization/playbook.md</code>:
      </p>
      <Code code={step8Code} lang="powershell" />
      <p>
        Trust the workspace authors when prompted, then choose the <strong>Accounts</strong> icon
        &gt; <strong>Sign in with GitHub to use GitHub Copilot</strong>.
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — VS Code]
        </strong>{" "}
        Configure the Upgrade agent for local execution next to the app: in{" "}
        <strong>Extensions</strong>, enable <strong>GitHub Copilot upgrade</strong> and disable{" "}
        <strong>GitHub Copilot modernization</strong> (for Workspace) if installed. In Copilot Chat,
        set <strong>Session Target</strong> to <strong>Local</strong>, press <code>F1</code> &gt;{" "}
        <strong>MCP: List Servers</strong> &gt; <strong>Upgrade</strong> &gt;{" "}
        <strong>Configure Model Access</strong> to allow your models, select{" "}
        <strong>Upgrade</strong> in the agent picker, and send <code>&quot;hello&quot;</code>.
      </p>
    </li>
  </ol>
</Steps>
