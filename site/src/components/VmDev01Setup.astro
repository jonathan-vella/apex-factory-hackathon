---
import { Aside, Code, Steps } from "@astrojs/starlight/components";

interface Props {
  pathMode: "self-service" | "lead-provisioned";
}

const { pathMode } = Astro.props;
const isPathB = pathMode === "lead-provisioned";

const step1PathA = `cd ~/src/<your-repo>/factory
./scripts/Get-PipelineEvidence.ps1
$s = Get-Content .local/settings.json | ConvertFrom-Json
(Get-Content ".local/$($s.subscriptionId)/datacenter.json" | ConvertFrom-Json).adminPassword
$s.subscriptionId
$s.suffix
git remote get-url origin`;

const stepBootstrapPathB = `New-Item -ItemType Directory -Force C:\\LabTools | Out-Null
Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/jonathan-vella/apex-factory-hackathon/main/scripts/Initialize-Workstation.ps1' -OutFile C:\\LabTools\\Initialize-Workstation.ps1
pwsh -NoProfile -File C:\\LabTools\\Initialize-Workstation.ps1`;

const stepBootstrapPathA = `New-Item -ItemType Directory -Force C:\\LabTools | Out-Null
Invoke-WebRequest -Uri 'https://raw.githubusercontent.com/jonathan-vella/apex-factory-hackathon/main/scripts/Initialize-Workstation.ps1' -OutFile C:\\LabTools\\Initialize-Workstation.ps1
pwsh -NoProfile -File C:\\LabTools\\Initialize-Workstation.ps1 -GitHubOwner '<your-org>' -RepoName '<your-repo>' -Suffix '<suffix>'`;

const step3GitHub = `gh auth login --hostname github.com --git-protocol https --scopes repo,workflow --web
gh auth setup-git
$u = gh api user | ConvertFrom-Json
git config --global user.name ($u.name ?? $u.login)
git config --global user.email "$($u.id)+$($u.login)@users.noreply.github.com"`;

const step4AzurePathA = `az login --use-device-code
az account set --subscription '<workload-subscription-id>'
az account show --query name -o tsv
[Environment]::SetEnvironmentVariable('AZURE_TOKEN_CREDENTIALS', 'AzureCliCredential', 'User')`;

const step4AzurePathB = `az login --tenant '<tenant-id>' --use-device-code
az account set --subscription '<workload-subscription-id>'
az account show --query name -o tsv
[Environment]::SetEnvironmentVariable('AZURE_TOKEN_CREDENTIALS', 'AzureCliCredential', 'User')`;

const step5Clone = isPathB
  ? `git clone https://github.com/<org>/<your-repo>.git C:\\src\\<your-repo>
cd C:\\src\\<your-repo>`
  : `git clone https://github.com/<your-org>/<your-repo>.git C:\\src\\<your-repo>
cd C:\\src\\<your-repo>`;

const step6SettingsPathA = `cd C:\\src\\<your-repo>\\factory
./scripts/Initialize-Settings.ps1 -TenantId '<tenant-id>' -SubscriptionId '<workload-subscription-id>' -SharedSubscriptionId '<shared-services-subscription-id>' -MemberIndex <index> -Location '<location>' -Suffix '<suffix>' -WriteLabCredentials`;

const step6SettingsPathB = `cd C:\\src\\<your-repo>\\factory
./scripts/Initialize-Settings.ps1 -TenantId '<tenant-id>' -SubscriptionId '<workload-subscription-id>' -SharedSubscriptionId '<shared-services-subscription-id>' -MemberIndex <index> -Location '<location>' -Suffix '<suffix>' -WriteLabCredentials`;

const step7Code = `code C:\\src\\<your-repo>`;
---

{isPathB ? (
  <p>
    <strong>Who runs this:</strong> Every student, on their own assigned <code>vm-dev01</code>.
    <br />
    <strong>Why:</strong> Every challenge (<code>C1</code> to <code>C10</code>) runs inside your{" "}
    <code>vm-dev01</code> workstation in Azure—reaching both GitHub and the private endpoints in
    your datacenter and spoke network from a single clone (<code>C:\src\&lt;your-repo&gt;</code> on{" "}
    <code>main</code>).
  </p>
) : (
  <p>
    <strong>Who runs this:</strong> Every team member—including the team lead—for their own{" "}
    <code>vm-dev01</code>.
    <br />
    <strong>Why:</strong> Every challenge (<code>C1</code> to <code>C10</code>) runs inside your{" "}
    <code>vm-dev01</code> workstation in Azure—reaching both GitHub and the private endpoints in
    your datacenter and spoke network from a single clone (<code>C:\src\&lt;your-repo&gt;</code> on{" "}
    <code>main</code>).
  </p>
)}

<Aside type="tip" title="One GitHub repo and one local clone on vm-dev01">
  {isPathB ? (
    <p>
      <strong>Do not create a new GitHub repository.</strong> Reuse the single private{" "}
      <code>&lt;org&gt;/&lt;your-repo&gt;</code> student repo from your Handoff Card (for example{" "}
      <code>&lt;org&gt;/&lt;event&gt;-student-01</code>). You clone it once to{" "}
      <code>C:\src\&lt;your-repo&gt;</code> on <code>main</code>: <code>app/ContosoUniversity</code>
      , <code>.github/modernization/</code>, <code>.github/skills/</code>,{" "}
      <code>infra/bicep/university/</code> and <code>factory/</code> all live side by side in that
      single folder.
    </p>
  ) : (
    <p>
      <strong>Do not create a new GitHub repository.</strong> Reuse the single private{" "}
      <code>&lt;your-org&gt;/&lt;your-repo&gt;</code> repo you created in{" "}
      <a href="/deploy/set-up-your-repo/#11-create-your-repo-everyone">Step 1.1</a>. You clone it
      once to <code>C:\src\&lt;your-repo&gt;</code> on <code>main</code>:{" "}
      <code>app/ContosoUniversity</code>, <code>.github/modernization/</code>,{" "}
      <code>.github/skills/</code>, <code>infra/bicep/university/</code> and <code>factory/</code>{" "}
      all live side by side in that single folder.
    </p>
  )}
</Aside>

<p>
  Keep two browser windows open on your own computer: one for Azure Bastion, the other for the Azure
  portal and this guide (allow portal pop-ups and Bastion clipboard access, and enter device sign-in
  codes on your own computer where your passkeys and password manager work). Each step below labels{" "}
  <strong>where</strong> you run it:
</p>

<Steps>
  <ol>
    <li>
      {isPathB ? (
        <>
          <p>
            <strong>[On your laptop — lab password]</strong> Have your <code>vm-dev01</code>{" "}
            <code>labadmin</code> password ready from{" "}
            <a href="https://github.com/jonathan-vella/apex-factory-hackathon/blob/main/infra/datacenter/README.md#credentials">
              infra/datacenter/README.md
            </a>{" "}
            (or from your team lead / Handoff Card). You do not need to look up any subscription or
            tenant GUIDs—<code>Initialize-Workstation.ps1</code> auto-detects them on{" "}
            <code>vm-dev01</code>.
          </p>
        </>
      ) : (
        <>
          <p>
            <strong>
              [In Azure Cloud Shell — <code>~/src/&lt;your-repo&gt;/factory</code>]
            </strong>{" "}
            Download your readiness artifact and print your <code>vm-dev01</code> password, Step 1
            suffix, and repo URL:
          </p>
          <Code code={step1PathA} lang="powershell" />
          <p>
            <code>Get-PipelineEvidence.ps1</code> saves{" "}
            <code>factory/evidence/readiness/test-datacenter.txt</code> and writes{" "}
            <code>.local/&lt;subscription-id&gt;/datacenter.json</code>. Commit and push{" "}
            <code>factory/evidence/readiness/test-datacenter.txt</code> from Cloud Shell (
            <code>
              git add evidence/readiness/test-datacenter.txt &amp;&amp; git commit -m &quot;docs:
              add readiness test output&quot; &amp;&amp; git push
            </code>
            ), and keep the <code>labadmin</code> password, <code>$s.suffix</code>, and repo name
            for step 3.
          </p>
        </>
      )}
    </li>

    <li>
      <p>
        <strong>[On your laptop browser — Azure portal]</strong> Connect to <code>vm-dev01</code>{" "}
        through Bastion so you have a desktop inside the private datacenter network. Filter the
        portal to your directory and workload subscription, open <strong>Resource groups</strong>{" "}
        &gt; <strong>rg-datacenter</strong> &gt; <strong>vm-dev01</strong> &gt;{" "}
        <strong>Connect</strong> &gt; <strong>Bastion</strong>, select <strong>Password</strong>,
        enter <code>labadmin</code> and the password from step 1, and choose{" "}
        <strong>Connect</strong>. On first sign-in, wait up to five minutes for VS Code extensions
        to finish installing.
      </p>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — PowerShell 7 (<code>pwsh</code>)]
        </strong>{" "}
        Run <code>Initialize-Workstation.ps1</code> to bootstrap <code>vm-dev01</code> in one
        command. It installs Node.js 24 LTS and <code>azd</code> if your VM was deployed before the
        single-clone update, signs you in to GitHub (<code>repo,workflow</code> scopes), Azure CLI,
        and <code>azd</code>, sets <code>AZURE_TOKEN_CREDENTIALS=AzureCliCredential</code>,
        auto-detects your <code>MemberIndex</code>, workload subscription, and shared hub
        subscription from the VM&apos;s private IP and hub peering, creates (or clones) your private
        GitHub repository at <code>C:\src\&lt;your-repo&gt;</code> on <code>main</code> with the kit
        imported, writes <code>factory/.local/settings.json</code> and <code>datacenter.json</code>,
        and opens VS Code:
      </p>
      <Code code={isPathB ? stepBootstrapPathB : stepBootstrapPathA} lang="powershell" />
      {isPathB && (
        <p>
          <em>
            By default this creates a private repository{" "}
            <code>&lt;your-github-username&gt;/apex-factory-m&lt;nn&gt;</code> from{" "}
            <code>jonathan-vella/apex-accelerator</code>. If your team lead pre-created an
            organization repository on a Handoff Card, append{" "}
            <code>
              -GitHubOwner &apos;&lt;org&gt;&apos; -RepoName &apos;&lt;your-repo&gt;&apos; -Suffix
              &apos;&lt;suffix&gt;&apos;
            </code>
            .
          </em>
        </p>
      )}
      <details>
        <summary>What Initialize-Workstation.ps1 runs under the hood (manual reference)</summary>
        <p>
          If you ever need to run or inspect the individual sign-in, clone, and settings steps by
          hand in PowerShell 7 (<code>pwsh</code>) on <code>vm-dev01</code>:
        </p>
        <Code code={step3GitHub} lang="powershell" />
        <Code code={isPathB ? step4AzurePathB : step4AzurePathA} lang="powershell" />
        <Code code={step5Clone} lang="powershell" />
        <Code code={isPathB ? step6SettingsPathB : step6SettingsPathA} lang="powershell" />
        <Code code={step7Code} lang="powershell" />
      </details>
    </li>

    <li>
      <p>
        <strong>
          [On <code>vm-dev01</code> — VS Code]
        </strong>{" "}
        Trust the workspace authors when prompted, sign in to GitHub Copilot (
        <strong>Accounts</strong> icon &gt;{" "}
        <strong>Sign in with GitHub to use GitHub Copilot</strong>), and configure the Upgrade agent
        for local execution next to the app: in <strong>Extensions</strong>, enable{" "}
        <strong>GitHub Copilot upgrade</strong> and disable{" "}
        <strong>GitHub Copilot modernization</strong> (for Workspace) if installed. In Copilot Chat,
        set <strong>Session Target</strong> to <strong>Local</strong>, press <code>F1</code> &gt;{" "}
        <strong>MCP: List Servers</strong> &gt; <strong>Upgrade</strong> &gt;{" "}
        <strong>Configure Model Access</strong> to allow your models, select{" "}
        <strong>Upgrade</strong> in the agent picker, and send <code>&quot;hello&quot;</code>. Also
        confirm <code>01-Orchestrator</code> and <code>08-As-Built</code> appear in the agent
        picker.
      </p>
    </li>
  </ol>
</Steps>
