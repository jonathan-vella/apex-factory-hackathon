@{
    ViewBag.Title = "Admin Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12">
        <h2>@ViewBag.Title</h2>
        <p class="text-muted">Real-time notifications for entity operations across the system.</p>
        
        <div class="alert alert-info" role="alert">
            <strong>Real-time Notifications</strong><br />
            As an administrator, you will receive notifications in the top-right corner when any entity (students, courses, instructors, departments) is created, updated, or deleted by any user in the system.
        </div>
        
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="bi bi-bell"></i> Notification Settings
                </h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h4>Monitored Operations</h4>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <span class="label label-success">CREATE</span>
                                Entity creation operations
                            </li>
                            <li class="list-group-item">
                                <span class="label label-info">UPDATE</span>
                                Entity modification operations
                            </li>
                            <li class="list-group-item">
                                <span class="label label-warning">DELETE</span>
                                Entity deletion operations
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h4>Monitored Entities</h4>
                        <ul class="list-group">
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-user"></i>
                                Students
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-book"></i>
                                Courses
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-education"></i>
                                Instructors
                            </li>
                            <li class="list-group-item">
                                <i class="glyphicon glyphicon-briefcase"></i>
                                Departments
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="glyphicon glyphicon-cog"></i> Technology Information
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    <strong>Messaging unavailable:</strong> Broker-backed delivery is deferred until the approved messaging migration task.
                </div>
                
                <h4>Features:</h4>
                <ul>
                    <li><strong>Real-time delivery</strong> - Notifications appear immediately when operations occur</li>
                    <li><strong>Reliable messaging</strong> - Broker integration will be restored by the approved messaging migration</li>
                    <li><strong>Admin-only</strong> - Only administrators receive these notifications</li>
                    <li><strong>Auto-dismiss</strong> - Notifications automatically disappear after 8 seconds</li>
                    <li><strong>User-friendly</strong> - Click the × to dismiss notifications manually</li>
                </ul>
                
                <h4>Queue Information:</h4>
                <p><strong>Broker:</strong> Not configured during the application framework upgrade</p>
                <p><strong>Check Interval:</strong> 5 seconds</p>
                <p><strong>Max Visible Notifications:</strong> 5 at a time</p>
            </div>
        </div>
        
        <div class="card mt-3">
            <div class="card-body">
            <h4>Quick Test</h4>
            <p>To test the notification system, try performing any of the following operations:</p>
            <ul>
                <li><a asp-controller="Students" asp-action="Create" class="btn btn-sm btn-primary">Create a new student</a></li>
                <li><a asp-controller="Courses" asp-action="Create" class="btn btn-sm btn-success">Create a new course</a></li>
                <li><a asp-controller="Instructors" asp-action="Create" class="btn btn-sm btn-warning">Create a new instructor</a></li>
                <li><a asp-controller="Departments" asp-action="Create" class="btn btn-sm btn-info">Create a new department</a></li>
            </ul>
            <p class="text-muted">After creating, editing, or deleting any entity, you should see a notification appear in the top-right corner of your screen.</p>
            </div>
        </div>
    </div>
</div>
